datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Memory {
  id        String   @id @default(cuid())
  type      String
  content   String
  status    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Command {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("PENDING")
  response  String?
  createdAt DateTime @default(now())
}

model RevenueEvent {
  id            String   @id @default(cuid())
  service       String
  requestId     String   @unique
  apiKeyHash    String
  units         Int
  grossRevenue  Float    @default(0)
  variableCost  Float    @default(0)
  quality       Float    @default(0)
  status        String
  metadata      String?
  createdAt     DateTime @default(now())
}
