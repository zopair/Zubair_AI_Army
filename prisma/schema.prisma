datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Memory {
  id        String   @id @default(cuid())
  type      String
  content   String
  status    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Command {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("PENDING")
  response  String?
  createdAt DateTime @default(now())
}

model Product {
  id             String   @id
  slug           String   @unique
  name           String
  status         String   @default("DRAFT")
  deliveryType   String   @default("DIGITAL")
  price          Float    @default(0)
  currency       String   @default("USD")
  checkoutPath   String?
  deliveryTarget String?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
  entitlements   Entitlement[]
  revenueEvents  RevenueEvent[]
}

model Lead {
  id          String   @id @default(cuid())
  source      String
  externalRef String?
  status      String   @default("NEW")
  score       Int      @default(0)
  productId   String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([source, status])
}

model Order {
  id             String   @id @default(cuid())
  productId      String
  customerId     String
  amount         Float
  currency       String   @default("USD")
  status         String   @default("PENDING_PAYMENT")
  paymentIntentId String?
  referralId     String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  paidAt         DateTime?
  deliveredAt    DateTime?
  product        Product  @relation(fields: [productId], references: [id])
  @@index([customerId, status])
}

model PaymentIntent {
  id           String   @id @default(cuid())
  productId    String
  customerId   String
  amount       Float
  currency     String   @default("USD")
  provider     String   @default("binance_pay")
  merchantUid  String
  referralId   String?
  status       String   @default("PENDING")
  externalRef  String?  @unique
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
}

model Entitlement {
  id          String   @id @default(cuid())
  customerId  String
  productId   String
  orderId     String
  status      String   @default("ACTIVE")
  deliveryRef String?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  product     Product  @relation(fields: [productId], references: [id])
  @@unique([customerId, productId, orderId])
}

model ApiKey {
  id          String   @id @default(cuid())
  customerId  String
  productId   String
  keyHash     String   @unique
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
}

model CustomerCredit {
  id             String   @id @default(cuid())
  customerId     String
  productId      String
  unitsRemaining Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@unique([customerId, productId])
}

model RevenueEvent {
  id           String   @id @default(cuid())
  service      String
  requestId    String   @unique
  customerId   String
  agentId      String?
  productId    String
  units        Int
  grossRevenue Float    @default(0)
  variableCost Float    @default(0)
  netRevenue   Float    @default(0)
  status       String
  metadata     String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
}

model ReferralAttribution {
  id             String   @id @default(cuid())
  referralId     String   @unique
  agentId        String
  productId      String
  customerId     String
  revenueEventId  String?  @unique
  status         String
  rewardAmount   Float    @default(0)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
}

model RewardSettlement {
  id             String   @id @default(cuid())
  referralId     String
  amount         Float
  currency       String   @default("USD")
  status         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  settledAt      DateTime?
}

model AgentRun {
  id          String   @id @default(cuid())
  agentId     String
  taskType    String
  status      String   @default("PENDING")
  inputHash   String?
  outputRef   String?
  cost        Float    @default(0)
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([agentId, status])
}

model SpendGuard {
  id              String   @id
  dailyLimit      Float    @default(0)
  spentToday      Float    @default(0)
  currency        String   @default("USD")
  killSwitch      Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model RecoveryIncident {
  id            String   @id @default(cuid())
  component     String
  fingerprint   String   @unique
  status        String   @default("OPEN")
  diagnosis     String?
  remediation   String?
  verification  String?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
}
