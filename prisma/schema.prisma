
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Memory {
  id        String   @id @default(cuid())
  type      String   // SOVEREIGN, EPISODIC, CONTEXT
  content   String
  status    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Command {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("PENDING") // PENDING, EXECUTING, COMPLETED
  response  String?
  createdAt DateTime @default(now())
}
